# Required: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key

# Optional settings
ANTHROPIC_MODEL=claude-sonnet-5-5
LOCAL_EATS_LOCATION=Sacramento, CA
LOCAL_EATS_PROVIDER=sample   # "sample" (offline) or "google" (live data)

# Only needed for --provider google
GOOGLE_PLACES_API_KEY=your-google-places-key
